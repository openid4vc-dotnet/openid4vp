<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>	  
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>	
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OpenID4VC.OpenID4VP.Dcql</PackageId>
    <Version>1.0.0-preview.3</Version>
    <Authors>Geert Doornbos</Authors>
    <Description>Digital Credentials Query Language (DCQL) implementation for .NET - A JSON-encoded query language for requesting Verifiable Presentations as defined in OpenID for Verifiable Presentations 1.0</Description>
    <PackageTags>DCQL;OpenID4VC;OID4VC;OpenID4VP</PackageTags>
    <RepositoryUrl>https://github.com/openid4vc-dotnet/openid4vp</RepositoryUrl>
	<IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenID4VC.Core\OpenID4VC.Core.csproj" />
  </ItemGroup>

</Project>
